msgstr "ការសាកល្បងតភ្ជាប់ IMAP បានបរាជ័យ។"

#, python-format
msgctxt "model:ir.message,text:connection_successful"
msgid "Successful IMAP test connection using account \"%(account)s\"."
msgstr "ការសាកល្បងតភ្ជាប់ IMAP ដោយប្រើគណនី «%(account)s» បានជោគជ័យ។"

#, python-format
msgctxt "model:ir.message,text:fetch_error"
msgid ""
"Error IMAP Server:\n"
"Could not get id \"%(email)s\" messages.\n"
"\n"
"%(msg)s"
msgstr ""
"មានកំហុសម៉ាស៊ីនមេ IMAP៖\n"
"មិនអាចទាញយកលេខសម្គាល់សារ «%(email)s» បានទេ។\n"
"\n"
"%(msg)s"

#, python-format
msgctxt "model:ir.message,text:general_error"
msgid ""
"Error IMAP Server:\n"
"\n"
"%(msg)s"
msgstr ""
"មានកំហុសម៉ាស៊ីនមេ IMAP៖\n"
"\n"
"%(msg)s"

#, python-format
msgctxt "model:ir.message,text:login_error"
msgid ""
"Error IMAP Server:\n"
"Login with user \"%(user)s\" failed.\n"
"\n"
"%(msg)s"
msgstr ""
"មានកំហុសម៉ាស៊ីនមេ IMAP៖\n"
"មិនអាចចូលដោយប្រើឈ្មោះអ្នកប្រើ «%(user)s» បានទេ។\n"
"\n"
"%(msg)s"

msgctxt "model:ir.message,text:msg_oauth_missing"
msgid "The IMAP is set to use oauth authentication and the token is missing."
msgstr "IMAP ត្រូវបានកំណត់ឱ្យប្រើការផ្ទៀងផ្ទាត់ OAuth ប៉ុន្តែបាត់ថូខិន។"

msgctxt "model:ir.message,text:msg_ssl_starttls"
msgid "SSL and STARTTLS cannot be enabled at the same time."
msgstr "មិនអាចបើក SSL និង STARTTLS ក្នុងពេលតែមួយបានទេ។"

#, python-format
msgctxt "model:ir.message,text:search_error"
msgid ""
"Error IMAP Server:\n"
"Could not search \"%(criteria)s\" messages.\n"
"\n"
"%(msg)s"
msgstr ""
"មានកំហុសម៉ាស៊ីនមេ IMAP៖\n"
"មិនអាចស្វែងរកសារតាមលក្ខណៈវិនិច្ឆ័យ «%(criteria)s» បានទេ។\n"
"\n"
"%(msg)s"

#, python-format
msgctxt "model:ir.message,text:select_error"
msgid ""
"Error IMAP Server:\n"
"Could not select \"%(folder)s\" mailbox.\n"
"\n"
"%(msg)s"
msgstr ""
"មានកំហុសម៉ាស៊ីនមេ IMAP៖\n"
"មិនអាចជ្រើសប្រអប់សំបុត្រ «%(folder)s» បានទេ។\n"
"\n"
"%(msg)s"

#, python-format
msgctxt "model:ir.message,text:test_details"
msgid ""
"IMAP test connection Details:\n"
"\n"
"%(msg)s"
msgstr ""
"ព័ត៌មានលម្អិតនៃការសាកល្បងតភ្ជាប់ IMAP៖\n"
