msgctxt "help:imap.server,action_after_read:"
msgid "The action to do after each email is readed."
msgstr "Az egyes e-mailek elolvasása után végrehajtandó művelet."

msgctxt "help:imap.server,destination_folder:"
msgid "The folder name where to move to on the server. Absolut path"
msgstr "A kiszolgálón található célmappa neve, abszolút elérési úttal."

msgctxt "help:imap.server,email:"
msgid "Default From (if active this option) and Reply Email"
msgstr "Alapértelmezett feladó (ha az opció aktív) és válaszcím"

msgctxt "help:imap.server,folder:"
msgid "The folder name where to read from on the server."
msgstr "A kiszolgálón található olvasandó mappa neve."

msgctxt "help:imap.server,mark_seen:"
msgid "Mark emails as seen on fetch."
msgstr "E-mailek megjelölése olvasottként lekéréskor."

msgctxt "help:imap.server,search_mode:"
msgid ""
"The criteria to filter when download messages. By default is only take the "
"unread mesages, but it is possible to take a time interval or a custom "
"selection"
msgstr ""
"Az üzenetek letöltésekor használt szűrési feltétel. Alapértelmezés szerint "
"csak az olvasatlan üzeneteket tölti le, de időszak vagy egyéni feltétel is "
"megadható."

msgctxt "help:imap.server,timeout:"
msgid "Time to wait until connection is established. In seconds."
msgstr "A kapcsolat létrejöttére való várakozás ideje másodpercben."

msgctxt "help:imap.server,verify_certificate:"
msgid ""
"Disabling verification keeps encryption but does not verify the identity of "
"the mail server."
msgstr ""
"Az ellenőrzés kikapcsolása megtartja a titkosítást, de nem ellenőrzi a "
"levelezőkiszolgáló személyazonosságát."

