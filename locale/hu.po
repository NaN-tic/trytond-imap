#, python-format
msgctxt "model:ir.message,text:login_error"
msgid ""
"Error IMAP Server:\n"
"Login with user \"%(user)s\" failed.\n"
"\n"
"%(msg)s"
msgstr ""
"IMAP-kiszolgálóhiba:\n"
"A(z) „%(user)s” felhasználó bejelentkezése sikertelen.\n"
"\n"
"%(msg)s"

msgctxt "model:ir.message,text:msg_oauth_missing"
msgid "The IMAP is set to use oauth authentication and the token is missing."
msgstr "Az IMAP OAuth-hitelesítésre van beállítva, de hiányzik a token."

msgctxt "model:ir.message,text:msg_ssl_starttls"
msgid "SSL and STARTTLS cannot be enabled at the same time."
msgstr "Az SSL és a STARTTLS nem engedélyezhető egyszerre."

#, python-format
msgctxt "model:ir.message,text:search_error"
msgid ""
"Error IMAP Server:\n"
"Could not search \"%(criteria)s\" messages.\n"
"\n"
"%(msg)s"
msgstr ""
"IMAP-kiszolgálóhiba:\n"
"Nem sikerült a(z) „%(criteria)s” feltételnek megfelelő üzeneteket keresni.\n"
"\n"
"%(msg)s"

#, python-format
msgctxt "model:ir.message,text:select_error"
msgid ""
"Error IMAP Server:\n"
"Could not select \"%(folder)s\" mailbox.\n"
"\n"
"%(msg)s"
msgstr ""
"IMAP-kiszolgálóhiba:\n"
"Nem sikerült kiválasztani a(z) „%(folder)s” postafiókot.\n"
"\n"
"%(msg)s"

