msgid "Successful IMAP test connection using account \"%(account)s\"."
msgstr "Sikeres IMAP-kapcsolatteszt a(z) „%(account)s” fiókkal."

#, python-format
msgctxt "model:ir.message,text:fetch_error"
msgid ""
"Error IMAP Server:\n"
"Could not get id \"%(email)s\" messages.\n"
"\n"
"%(msg)s"
msgstr ""
"IMAP-kiszolgálóhiba:\n"
"Nem sikerült lekérni a(z) „%(email)s” azonosítójú üzeneteket.\n"
"\n"
"%(msg)s"

#, python-format
